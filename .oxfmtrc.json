{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["*.hbs"],
    "trailingComma": "none",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "overrides": [
        {
            "files": ["*.md"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "sortPackageJson": true,
    "sortImports": true
}
